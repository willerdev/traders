{
  "expo": {
    "name": "Trade Guard",
    "slug": "trade-guards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.traderrank.pro",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload KYC and document images for payout verification.",
        "NSCameraUsageDescription": "Camera is used for chain vault liveness verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121a2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.traderrank.pro",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Trade Guard to access your photos for KYC uploads."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Trade Guard to use the camera for liveness verification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "5d079847-3a99-4af4-9bb5-1232a0298b31"
      }
    },
    "owner": "willerbinance"
  }
}
